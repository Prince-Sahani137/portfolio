{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pages:dev": "npm run build && wrangler pages dev out --d1=DB",
    "db:init:local": "wrangler d1 execute portfolio-guestbook --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute portfolio-guestbook --remote --file=schema.sql"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "@cloudflare/workers-types": "^5",
    "wrangler": "^4"
  }
}
